# ── Authentication & Secrets ────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL, MySQL, or SQLite) ──────────────────────────────────
# SQLite: sqlite+aiosqlite:///./varman.db
# PostgreSQL: postgresql+asyncpg://postgres:password@localhost:5432/varman_db
# MySQL: mysql+aiomysql://root:password@localhost:3306/varman_db
DATABASE_URL=sqlite+aiosqlite:///./varman.db

# ── Admin Operator Seed Account ──────────────────────────────────────────────
VARMAN_ADMIN_EMAIL=admin@varman.ai
VARMAN_ADMIN_PASSWORD=VarmanAdminSecure2026!
VARMAN_ADMIN_DISPLAY_NAME=Operator

# ── Storage & Uploads ────────────────────────────────────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=15728640
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# ── Hardware & Execution Runtime ─────────────────────────────────────────────
DEVICE=cpu
CV2_THREADS=1
ONNX_THREADS=1

# ── Protection Engine Defaults ───────────────────────────────────────────────
DEFAULT_PRESET=Balanced
ENABLE_GRID_LAYER=false
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
EOT_ITERATIONS=50
EPSILON_MAX=0.0313
SSIM_MIN_THRESHOLD=0.90

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
